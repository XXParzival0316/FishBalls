[sub_resource type="GDScript" id="GDScript_60tdj"]
script/source = "extends Area2D

var refrigerator_animaiton:PackedScene = preload(\"uid://cfm6n75qub11s\")

func _on_body_entered(body: Node2D) -> void:
	if body is Player:
		get_tree().change_scene_to_packed(refrigerator_animaiton)
"

