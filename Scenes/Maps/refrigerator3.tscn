[sub_resource type="GDScript" id="GDScript_fa2su"]
script/source = "extends Area2D

var congratulations_menu:PackedScene = preload(\"uid://d13b0ohxjywll\")

var fishball_here:bool = false
var fishball_clone_here:bool = false

func  _physics_process(delta: float) -> void:
	if fishball_here and fishball_clone_here:
		get_tree().change_scene_to_packed(congratulations_menu)



func _on_body_entered(body: Node2D) -> void:
	if body is Player:
		if body.name == \"FishBall\":
			await get_tree().create_timer(1.0).timeout
			fishball_here = true
		if body.name == \"FishBall_Clone\":
			await get_tree().create_timer(1.0).timeout
			fishball_clone_here = true	
"

